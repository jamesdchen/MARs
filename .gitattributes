# Enforce LF line endings for all text files to prevent Windows CRLF issues in CI
* text=auto eol=lf

# Explicitly mark binary files
*.wasm binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary

# Polymarket market data (plain git: each file is well under 50 MB; LFS is not allowed on public forks)
explorations/deep_hedging_cvar/polymarket/data/**/*.parquet binary
